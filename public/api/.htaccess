# Protect configuration and logs from direct public browser download
<FilesMatch "^(mail_config\.php|mail_debug\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
